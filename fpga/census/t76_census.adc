# T76 static census -- generated by gen_census.py, do not edit.
# Observed pins carry PULLTYPE = NONE and no DRIVESTRENGTH: they are
# inputs only and must not load or pull the buses they watch.

# Sampling clock (independent of the bus under test)
set_pin_assignment	{ i_clock_20M }	{ LOCATION = E10; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; PCICLAMP = ON; }

# UART out to the ISP header
set_pin_assignment	{ uart_tx }	{ LOCATION = M4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }

# Rail control driven to a static safe state (socket MUST be empty)
set_pin_assignment	{ ser_clk }	{ LOCATION = B10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }
set_pin_assignment	{ ser_data }	{ LOCATION = A10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }
set_pin_assignment	{ vpp_le }	{ LOCATION = B8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }
set_pin_assignment	{ vcc_le }	{ LOCATION = A6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }
set_pin_assignment	{ gnd_le }	{ LOCATION = A5; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }
set_pin_assignment	{ vpp_oe }	{ LOCATION = A9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }
set_pin_assignment	{ vcc_oe }	{ LOCATION = A8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }
set_pin_assignment	{ gnd_oe }	{ LOCATION = B6; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 20; PULLTYPE = NONE; }

# ISP header power/ground switches (27, 28 -> ground)
